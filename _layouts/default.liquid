<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}

    <!-- Source Serif / Sans (overrides config until Jekyll reloads _config.yml) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400&display=swap">

    <!-- Site-wide Soft Forest design system -->
    <style>
      :root {
        --global-bg-color: #f5f6f4;
        --global-text-color: #1e241f;
        --global-text-color-light: #5a635c;
        --global-theme-color: #2d6a4f;
        --global-hover-color: #1b4332;
        --global-hover-text-color: #ffffff;
        --global-footer-bg-color: #1e241f;
        --global-footer-text-color: #d4d9d4;
        --global-footer-link-color: #e8ebe8;
        --global-divider-color: rgba(30, 36, 31, 0.12);
        --global-card-bg-color: #ffffff;
        --global-code-bg-color: rgba(45, 106, 79, 0.07);
        --font-sans: "Source Sans 3", "LXGW WenKai Screen", sans-serif;
        --font-serif: "Source Serif 4", "LXGW WenKai Screen", serif;
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-sans);
        font-weight: 400;
        font-size: 1.05rem;
        line-height: 1.7;
        letter-spacing: 0.01em;
        color: var(--global-text-color);
        background-color: var(--global-bg-color);
        background-image:
          radial-gradient(ellipse 90% 55% at 8% -10%, rgba(45, 106, 79, 0.09), transparent 55%),
          radial-gradient(ellipse 70% 45% at 92% 8%, rgba(27, 67, 50, 0.06), transparent 50%),
          linear-gradient(180deg, #f7f8f6 0%, var(--global-bg-color) 28%, #f3f5f2 100%);
        background-attachment: fixed;
      }

      p, li, span, div, a {
        font-family: var(--font-sans);
      }

      h1, h2, h3, h4, h5, h6,
      .navbar-brand.title {
        font-family: var(--font-serif);
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--global-text-color);
      }

      h1 { font-size: 1.85rem; }
      h2 { font-size: 1.45rem; margin-top: 2rem; }
      h3, h4 { font-size: 1.2rem; }

      strong, b {
        font-weight: 600;
      }

      a {
        color: var(--global-theme-color);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.18em;
        transition: color 0.2s var(--ease-out), text-decoration-color 0.2s var(--ease-out);
      }

      a:hover {
        color: var(--global-hover-color);
      }

      /* Navbar */
      #navbar.navbar {
        background: rgba(245, 246, 244, 0.82) !important;
        backdrop-filter: blur(12px) saturate(1.2);
        -webkit-backdrop-filter: blur(12px) saturate(1.2);
        border-bottom: 1px solid var(--global-divider-color);
        box-shadow: none !important;
        padding-top: 0.55rem;
        padding-bottom: 0.55rem;
        transition: background 0.25s var(--ease-out), border-color 0.25s var(--ease-out);
      }

      .navbar-brand.title {
        font-size: 1.15rem !important;
        font-weight: 600 !important;
        letter-spacing: -0.015em;
        color: var(--global-text-color) !important;
        transition: color 0.2s var(--ease-out);
      }

      .navbar-brand.title:hover {
        color: var(--global-theme-color) !important;
      }

      .navbar .nav-link {
        font-family: var(--font-sans);
        font-size: 0.92rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        color: var(--global-text-color-light) !important;
        padding: 0.35rem 0.55rem !important;
        position: relative;
        transition: color 0.2s var(--ease-out);
      }

      .navbar .nav-link:hover,
      .navbar .nav-item.active > .nav-link {
        color: var(--global-theme-color) !important;
        font-weight: 500;
      }

      .navbar .nav-item.active > .nav-link::after {
        content: "";
        position: absolute;
        left: 0.55rem;
        right: 0.55rem;
        bottom: 0.1rem;
        height: 1.5px;
        background: var(--global-theme-color);
        border-radius: 1px;
        transform-origin: center;
        animation: nav-underline 0.35s var(--ease-out);
      }

      @keyframes nav-underline {
        from { transform: scaleX(0); opacity: 0; }
        to { transform: scaleX(1); opacity: 1; }
      }

      .lang-toggle {
        display: inline-flex;
        align-items: center;
        margin-left: 0.85rem;
        padding: 0.22rem 0.65rem;
        border: 1px solid rgba(45, 106, 79, 0.35);
        border-radius: 999px;
        font-family: var(--font-sans);
        font-size: 0.78rem;
        letter-spacing: 0.04em;
        color: var(--global-text-color-light);
        text-decoration: none !important;
        line-height: 1.4;
        white-space: nowrap;
        transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out), background 0.2s var(--ease-out);
      }

      .lang-toggle:hover {
        color: var(--global-theme-color);
        border-color: var(--global-theme-color);
        background: rgba(45, 106, 79, 0.06);
      }

      .lang-toggle .on { font-weight: 600; color: var(--global-theme-color); }
      .lang-toggle .sep { margin: 0 0.2rem; opacity: 0.4; }
      .lang-toggle .off { opacity: 0.55; font-weight: 400; }

      /* Main content */
      .container[role="main"] {
        animation: rise-in 0.55s var(--ease-out);
      }

      @keyframes rise-in {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @media (prefers-reduced-motion: reduce) {
        .container[role="main"],
        .navbar .nav-item.active > .nav-link::after {
          animation: none;
        }
      }

      /* Content figures (cats, genealogy, etc.) */
      .site-figure {
        display: block;
        max-width: min(420px, 100%);
        width: 100%;
        height: auto;
        margin: 1rem 0 0.35rem;
        border-radius: 14px;
        border: 1px solid rgba(45, 106, 79, 0.14);
        box-shadow:
          0 1px 2px rgba(30, 36, 31, 0.04),
          0 10px 26px rgba(30, 36, 31, 0.09);
        background: var(--global-card-bg-color);
        object-fit: cover;
      }

      .site-figure--portrait {
        max-width: min(280px, 70%);
      }

      .site-figure--wide {
        max-width: min(480px, 100%);
      }
      .cv-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.35rem;
        padding: 0.45rem 1.05rem;
        border: 1.5px solid var(--global-theme-color);
        border-radius: 2px;
        background: transparent;
        color: var(--global-theme-color) !important;
        font-family: var(--font-sans);
        font-size: 0.88rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        text-decoration: none !important;
        transition: background 0.22s var(--ease-out), color 0.22s var(--ease-out), transform 0.22s var(--ease-out), box-shadow 0.22s var(--ease-out);
      }

      .cv-btn:hover {
        background: var(--global-theme-color);
        color: #fff !important;
        box-shadow: 0 6px 18px rgba(45, 106, 79, 0.22);
        transform: translateY(-1px);
      }

      /* Research / news reading polish */
      .post article,
      .post .clearfix {
        max-width: 42rem;
      }

      .post hr {
        border: 0;
        border-top: 1px solid var(--global-divider-color);
        margin: 1.75rem 0;
        opacity: 1;
      }

      /* Footer */
      footer.fixed-bottom,
      footer.sticky-bottom {
        background: var(--global-footer-bg-color) !important;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 0.85rem;
        letter-spacing: 0.02em;
      }

      /* Progress bar */
      #progress {
        accent-color: var(--global-theme-color);
      }

      .toggle-container .nav-link {
        color: var(--global-text-color) !important;
      }

      .toggle-container .nav-link:hover {
        color: var(--global-hover-color) !important;
      }
    </style>
    {% if page.lang == 'zh' %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-screen-webfont@1.7.0/style.css">
    {% endif %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% assign toc_collapse = page.toc.collapse | default: 'expanded' %}
        {% assign toc_collapse_depth = page.toc.collapse_depth | default: '' %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
