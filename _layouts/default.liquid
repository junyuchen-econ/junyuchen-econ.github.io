<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}

    <!-- Source Serif / Sans + Playfair Display masthead (overrides config until Jekyll reloads _config.yml) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,700&family=Source+Sans+3:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400&display=swap">

    <!-- Site-wide Soft Forest design system -->
    <style>
      :root {
        --global-bg-color: #f3efe4;
        --global-text-color: #1a1a17;
        --global-text-color-light: #565248;
        --global-theme-color: #8a1a12;
        --global-hover-color: #5f110b;
        --global-hover-text-color: #f3efe4;
        --global-footer-bg-color: #1a1a17;
        --global-footer-text-color: #d9d4c6;
        --global-footer-link-color: #f0ebdd;
        --global-divider-color: rgba(26, 26, 23, 0.22);
        --global-card-bg-color: #faf7ee;
        --global-code-bg-color: rgba(26, 26, 23, 0.06);
        --paper-color: #f3efe4;
        --paper-sheet-color: #faf7ee;
        --ink-color: #1a1a17;
        --ink-rule: rgba(26, 26, 23, 0.85);
        --ink-rule-soft: rgba(26, 26, 23, 0.22);
        --accent-color: #8a1a12;
        --font-sans: "Source Sans 3", "LXGW WenKai Screen", sans-serif;
        --font-serif: "Source Serif 4", "LXGW WenKai Screen", Georgia, serif;
        --font-display: "Playfair Display", "Source Serif 4", "LXGW WenKai Screen", Georgia, serif;
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-serif);
        font-weight: 400;
        font-size: 1.05rem;
        line-height: 1.6;
        letter-spacing: 0;
        color: var(--global-text-color);
        background-color: var(--paper-color);
        background-image:
          linear-gradient(180deg, #f6f2e8 0%, var(--paper-color) 30%, #efeadd 100%);
        background-attachment: fixed;
      }

      p, li, blockquote {
        font-family: var(--font-serif);
      }

      h1, h2 {
        font-family: var(--font-display);
        font-weight: 800;
        letter-spacing: 0;
        line-height: 1.12;
        color: var(--global-text-color);
      }

      h3, h4, h5, h6 {
        font-family: var(--font-sans);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.13em;
        color: var(--global-text-color);
      }

      .navbar-brand.title {
        font-family: var(--font-display);
        font-weight: 800;
        letter-spacing: 0;
        color: var(--global-text-color);
      }

      h1 { font-size: 2.1rem; }
      h2 { font-size: 1.6rem; margin-top: 2rem; }
      h3 { font-size: 1.05rem; }
      h4 { font-size: 0.95rem; }
      h5, h6 { font-size: 0.85rem; }

      strong, b {
        font-weight: 700;
      }

      a {
        color: var(--global-theme-color);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.16em;
        transition: color 0.2s var(--ease-out), text-decoration-color 0.2s var(--ease-out);
      }

      a:hover {
        color: var(--global-hover-color);
      }

      /* Body / content links read as ink with a subtle rule, accent on hover */
      .container[role="main"] a {
        color: var(--ink-color);
        text-decoration: underline;
        text-decoration-color: var(--ink-rule-soft);
      }

      .container[role="main"] a:hover {
        color: var(--accent-color);
        text-decoration-color: var(--accent-color);
      }

      /* Masthead */
      #navbar.navbar {
        background: var(--paper-color) !important;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
        border-bottom: 3px double var(--ink-rule);
        box-shadow: none !important;
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
        transition: border-color 0.25s var(--ease-out);
      }

      .navbar-brand.title {
        font-size: 1.5rem !important;
        font-weight: 800 !important;
        letter-spacing: 0 !important;
        color: var(--global-text-color) !important;
        transition: color 0.2s var(--ease-out);
      }

      .navbar-brand.title:hover {
        color: var(--accent-color) !important;
      }

      .navbar .nav-link {
        font-family: var(--font-sans);
        font-size: 1.05rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--global-text-color) !important;
        padding: 0.35rem 0.6rem !important;
        position: relative;
        transition: color 0.2s var(--ease-out);
      }

      .navbar .nav-link:hover,
      .navbar .nav-item.active > .nav-link {
        color: var(--accent-color) !important;
      }

      .navbar .nav-item.active > .nav-link::after {
        content: "";
        position: absolute;
        left: 0.6rem;
        right: 0.6rem;
        bottom: 0.05rem;
        height: 2px;
        background: var(--ink-color);
        border-radius: 0;
        transform-origin: center;
        animation: nav-underline 0.35s var(--ease-out);
      }

      @keyframes nav-underline {
        from { transform: scaleX(0); opacity: 0; }
        to { transform: scaleX(1); opacity: 1; }
      }

      /* Stacked masthead: nameplate + language toggle on top, section
         links centered on their own full-width row below (all widths). */
      #navbar > .container {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
      }

      #navbar .navbar-toggler-main {
        display: none !important;
      }

      #navbar .navbar-collapse-main {
        order: 3;
        display: flex !important;
        flex-basis: 100% !important;
        width: 100% !important;
        flex-grow: 0;
        margin-top: 0.4rem;
        padding-top: 0.35rem;
        border-top: 1px solid var(--ink-rule-soft);
        text-align: center;
      }

      #navbar .navbar-menu-list {
        flex-direction: row !important;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.4rem 1.4rem;
        margin-left: 0;
        width: 100%;
      }

      .lang-toggle {
        display: inline-flex;
        align-items: center;
        order: 2;
        gap: 0.3rem;
        flex-shrink: 0;
        margin-left: auto;
        padding: 0.28rem 0.5rem;
        border: none;
        border-radius: 999px;
        font-family: var(--font-sans);
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--global-text-color-light);
        text-decoration: none !important;
        line-height: 1;
        white-space: nowrap;
        transition: color 0.2s var(--ease-out), background 0.2s var(--ease-out);
      }

      .lang-toggle i {
        font-size: 0.95rem;
        opacity: 0.85;
      }

      .lang-toggle:hover {
        color: var(--accent-color);
        background: rgba(26, 26, 23, 0.07);
      }

      /* On phones: masthead wraps — title + toggle on top, section
         links on their own full-width row below (like a newspaper). */
      @media (max-width: 575.98px) {
        #navbar.navbar {
          padding-top: 0.4rem;
          padding-bottom: 0.3rem;
        }

        #navbar > .container {
          flex-wrap: wrap;
          padding-left: 0.75rem;
          padding-right: 0.75rem;
        }

        .navbar-brand.title {
          font-size: 1.25rem !important;
          margin-right: 0.3rem;
        }

        .lang-toggle {
          order: 2;
          margin-left: auto;
          gap: 0.2rem;
          padding: 0.22rem 0.32rem;
          font-size: 0.78rem;
        }

        #navbar .navbar-collapse-main {
          order: 3;
          flex-basis: 100% !important;
          width: 100% !important;
          flex-grow: 0;
          margin-top: 0.35rem;
          padding-top: 0.3rem;
          border-top: 1px solid var(--ink-rule-soft);
        }

        #navbar .navbar-menu-list {
          width: 100%;
          justify-content: center;
          flex-wrap: wrap;
          gap: 0.3rem 1rem;
        }

        .navbar .nav-link {
          font-size: 1rem;
          letter-spacing: 0.05em;
          padding: 0.2rem 0.25rem !important;
        }

        .container[role="main"] {
          width: auto;
          margin-left: 0.85rem;
          margin-right: 0.85rem;
          padding: 1.4rem 1.15rem 1.6rem;
        }

        /* Left-align on narrow screens to avoid justified word gaps */
        .container[role="main"] p {
          text-align: left;
          hyphens: none;
          -webkit-hyphens: none;
        }
      }

      /* Keep visible paper margins when the window is narrower than the
         max content width (otherwise the sheet spans edge-to-edge). */
      @media (min-width: 576px) and (max-width: 991.98px) {
        .container[role="main"] {
          width: auto;
          max-width: none;
          margin-left: 1.75rem;
          margin-right: 1.75rem;
        }
      }

      /* Main content — a sheet of newsprint */
      .container[role="main"] {
        animation: rise-in 0.55s var(--ease-out);
        background: var(--paper-sheet-color);
        border: 1px solid var(--ink-rule-soft);
        padding: 2.4rem 2.6rem 2.6rem;
        box-shadow: 0 1px 0 rgba(26, 26, 23, 0.05), 0 14px 34px rgba(26, 26, 23, 0.08);
      }

      @keyframes rise-in {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @media (prefers-reduced-motion: reduce) {
        .container[role="main"],
        .navbar .nav-item.active > .nav-link::after {
          animation: none;
        }
      }

      /* Justified newspaper columns */
      .container[role="main"] p {
        text-align: justify;
        text-justify: inter-word;
        hyphens: auto;
        -webkit-hyphens: auto;
      }

      /* Section headings with hairline rules */
      .container[role="main"] h1,
      .container[role="main"] h2,
      .container[role="main"] h3,
      .container[role="main"] h4,
      .container[role="main"] h5,
      .container[role="main"] h6 {
        margin-bottom: 0.9rem;
        padding-bottom: 0.32rem;
        border-bottom: 1px solid var(--ink-rule);
      }

      /* Big display headlines get a heavier double rule */
      .container[role="main"] h1,
      .container[role="main"] h2 {
        border-bottom: 3px double var(--ink-rule);
        padding-bottom: 0.4rem;
      }


      /* Content figures (cats, genealogy, etc.) */
      .site-figure {
        display: block;
        max-width: min(420px, 100%);
        width: 100%;
        height: auto;
        margin: 1rem 0 0.35rem;
        border-radius: 2px;
        border: 1px solid var(--ink-rule);
        padding: 5px;
        box-shadow: 0 1px 2px rgba(26, 26, 23, 0.06), 0 10px 24px rgba(26, 26, 23, 0.1);
        background: var(--paper-sheet-color);
        object-fit: cover;
      }

      .site-figure--portrait {
        max-width: min(280px, 70%);
      }

      .site-figure--wide {
        max-width: min(480px, 100%);
      }
      .cv-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.35rem;
        padding: 0.45rem 1.05rem;
        border: 1.5px solid var(--ink-color);
        border-radius: 0;
        background: transparent;
        color: var(--ink-color) !important;
        font-family: var(--font-sans);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-decoration: none !important;
        transition: background 0.22s var(--ease-out), color 0.22s var(--ease-out), transform 0.22s var(--ease-out), box-shadow 0.22s var(--ease-out);
      }

      .cv-btn:hover {
        background: var(--ink-color);
        color: var(--paper-sheet-color) !important;
        box-shadow: 0 6px 18px rgba(26, 26, 23, 0.22);
        transform: translateY(-1px);
      }

      /* Research / news reading polish */
      .post article,
      .post .clearfix {
        max-width: 42rem;
      }

      .post hr,
      .container[role="main"] hr {
        border: 0;
        border-top: 1px solid var(--ink-rule);
        margin: 1.75rem 0;
        opacity: 1;
      }

      /* Footer */
      footer.fixed-bottom,
      footer.sticky-bottom {
        background: var(--global-footer-bg-color) !important;
        border-top: 3px double rgba(240, 235, 221, 0.35);
        font-size: 0.72rem;
        letter-spacing: 0.02em;
      }

      /* Progress bar */
      #progress {
        accent-color: var(--global-theme-color);
      }

      .toggle-container .nav-link {
        color: var(--global-text-color) !important;
      }

      .toggle-container .nav-link:hover {
        color: var(--global-hover-color) !important;
      }
    </style>
    {% if page.lang == 'zh' %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-screen-webfont@1.7.0/style.css">
    {% endif %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% assign toc_collapse = page.toc.collapse | default: 'expanded' %}
        {% assign toc_collapse_depth = page.toc.collapse_depth | default: '' %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
