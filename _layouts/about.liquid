---
layout: default
---
<div class="post about-page">
  <article>
    <!-- Front-page headline: the first paragraph of the page, set large across the full width -->
    {% assign lead = content | split: '</p>' | first | append: '</p>' %}
    {% assign rest = content | remove_first: lead %}
    <div class="front-lead">{{ lead }}</div>

    {% if page.profile %}
      <div class="profile profile-top">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% assign profile_image_class = 'img-fluid profile-img' %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          <div class="profile-photo">
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          </div>
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix about-body">{{ rest }}</div>

    <!-- Learning blog: full-width feature cards at the foot of the page -->
    {% include learning_blog.liquid %}

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center_margin.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  </article>
</div>

<style>
  /* Front page: photo + contact notice in a narrow left column,
     introduction in the wide right column, separated by a column rule. */
  .about-page article {
    max-width: none;
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 0 2.4rem;
    align-items: start;
  }

  .profile.profile-top {
    grid-column: 1;
    float: none;
    width: auto !important;
    max-width: 100%;
    margin: 0.6rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: left;
  }

  .profile-photo {
    width: 100%;
    padding: 4px;
    border-radius: 0;
    overflow: hidden;
    background: var(--paper-color, #f3ecdc);
    border: 1px solid var(--ink-rule, #1d1a16);
    box-shadow: none;
  }

  .profile-photo figure {
    margin: 0;
    width: 100%;
    line-height: 0;
  }

  .profile-photo figure img,
  .profile-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
    box-shadow: none;
  }

  /* Contact details set as a boxed notice */
  .profile.profile-top .more-info {
    margin: 0;
    padding: 0.85rem 1rem 0.95rem;
    border: 3px double var(--ink-rule, #1d1a16);
    text-align: left;
  }

  .profile.profile-top .more-info .profile-card {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--global-text-color-light);
  }

  .profile.profile-top .more-info .profile-card > p {
    display: block !important;
  }

  .profile.profile-top .more-info .profile-card > p.profile-name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--global-text-color);
    margin: 0 0 0.45rem 0 !important;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--ink-rule, #1d1a16);
    line-height: 1.15;
  }

  .profile.profile-top .more-info .profile-card > p.profile-name:lang(zh) {
    font-family: var(--font-cjk);
    font-weight: 900;
  }

  .profile.profile-top .more-info .profile-card > p.profile-meta {
    margin: 0.1rem 0 !important;
  }

  .profile.profile-top .more-info .profile-card > p.profile-email {
    margin: 0.6rem 0 0.45rem 0 !important;
  }

  .profile.profile-top .more-info .profile-email a {
    font-weight: 700;
    color: var(--global-text-color);
    text-decoration: none;
  }

  .profile.profile-top .more-info .profile-email a:hover {
    color: var(--accent-color);
    text-decoration: underline;
  }

  .profile.profile-top .more-info .profile-social {
    display: flex;
    justify-content: flex-start;
    gap: 0.9rem;
    margin-top: 0.3rem;
  }

  .profile.profile-top .more-info .profile-social a,
  .profile.profile-top .more-info .profile-social span {
    color: var(--global-text-color);
    font-size: 1.25rem;
    transition: color 0.2s var(--ease-out);
    display: inline-flex;
  }

  .profile.profile-top .more-info .profile-social a:hover {
    color: var(--accent-color);
    text-decoration: none;
  }

  .profile.profile-top .more-info .profile-wechat {
    margin: 0.45rem 0 0;
    font-size: 0.8rem;
  }

  .about-body {
    grid-column: 2;
    max-width: none;
    margin: 0;
    padding-left: 2.4rem;
    border-left: 1px solid var(--ink-rule, #1d1a16);
    font-size: 1.02rem;
  }

  /* Front-page headline across both columns, between heavy rules */
  .front-lead {
    grid-column: 1 / -1;
    margin: 0.3rem 0 1.8rem;
    padding: 0.9rem 0 1rem;
    border-top: 4px double var(--ink-rule, #1d1a16);
    border-bottom: 4px double var(--ink-rule, #1d1a16);
    text-align: center;
  }

  .container[role="main"] .front-lead p {
    margin: 0 auto;
    max-width: 46rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.6vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-wrap: balance;
  }

  .container[role="main"] .front-lead p:lang(zh) {
    font-family: var(--font-cjk);
    font-weight: 900;
    font-size: clamp(1.45rem, 3.2vw, 2.25rem);
    letter-spacing: 0.02em;
  }

  .learning-blog {
    grid-column: 1 / -1;
    margin-top: 1.4rem;
  }

  .about-body h4 {
    margin-top: 1.6rem;
    margin-bottom: 0.6rem;
  }

  .about-body ul {
    margin: 0.2rem 0 0.15rem 0;
    padding-left: 1.2rem;
  }

  .about-body li {
    margin: 0.15rem 0;
  }

  .about-body p:has(.cv-btn) {
    margin-top: 2rem;
    padding-top: 1.2rem;
    border-top: 1px dashed var(--ink-rule-soft);
  }

  @media (max-width: 767.98px) {
    .about-page article {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Same stacked column as on desktop: photo, then the contact box at the same width */
    .profile.profile-top {
      width: 100% !important;
      max-width: 18rem;
      margin-bottom: 1.6rem;
    }

    .about-body {
      grid-column: 1;
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
