<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      <a class="navbar-brand title" style="font-size: inherit; font-weight: normal;" href="{% if page.lang == 'zh' %}{{ '/zh/' | relative_url }}{% else %}{{ '/' | relative_url }}{% endif %}">
        {% if page.lang == 'zh' %}陈俊宇{% else %}Junyu Chen{% endif %}
      </a>
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">

          {% if page.lang == 'zh' %}
            <!-- Chinese nav -->
            <li class="nav-item {% if page.permalink == '/zh/' %}active{% endif %}">
              <a class="nav-link" href="{{ '/zh/' | relative_url }}">首页</a>
            </li>
            <li class="nav-item {% if page.permalink == '/zh/news/' %}active{% endif %}">
              <a class="nav-link" href="{{ '/zh/news/' | relative_url }}">动态</a>
            </li>
            <li class="nav-item {% if page.permalink == '/zh/research/' %}active{% endif %}">
              <a class="nav-link" href="{{ '/zh/research/' | relative_url }}">研究</a>
            </li>
            <li class="nav-item {% if page.permalink == '/zh/links/' %}active{% endif %}">
              <a class="nav-link" href="{{ '/zh/links/' | relative_url }}">其他链接</a>
            </li>
          {% else %}
            <!-- English nav -->
            {% for page in site.pages %}
              {% if page.permalink == '/' %} {% assign about_title = page.nav_title | default: page.title %} {% endif %}
            {% endfor %}

            <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
              <a class="nav-link" href="{{ '/' | relative_url }}">
                {{- about_title }}
                {% if page.permalink == '/' %}
                  <span class="sr-only">(current)</span>
                {% endif %}
              </a>
            </li>

            {% assign sorted_pages = site.pages | sort: 'nav_order' %}
            {% for p in sorted_pages %}
              {% if p.nav and p.autogen == null %}
                {% if p.dropdown %}
                  {% assign has_active_child = false %}
                  {% for child in p.children %}
                    {% if page.title == child.title %}
                      {% assign has_active_child = true %}
                    {% endif %}
                  {% endfor %}
                  <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                    <a
                      class="nav-link dropdown-toggle"
                      href="#"
                      id="navbarDropdown"
                      role="button"
                      data-nav-dropdown-toggle="true"
                      aria-haspopup="true"
                      aria-expanded="false"
                    >
                      {{- p.title }}
                      {% if page.title == p.title or has_active_child %}
                        <span class="sr-only">(current)</span>
                      {% endif %}
                    </a>
                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                      {% for child in p.children %}
                        {% if child.title == 'divider' %}
                          <div class="dropdown-divider"></div>
                        {% else %}
                          <a
                            class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                            href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                          >
                            {{- child.title -}}
                          </a>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </li>
                {% else %}
                  {% assign parent_link = p.permalink | remove: 'index.html' %}
                  <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                    {%- if p.permalink contains '://' -%}
                      {%- assign url = p.permalink -%}
                    {%- elsif p.permalink contains '/blog/' -%}
                      {%- assign url = '/blog/' -%}
                    {%- else -%}
                      {%- assign url = p.url -%}
                    {%- endif %}
                    <a class="nav-link" href="{{ url | relative_url }}">
                      {{- p.title }}
                      {% if page.url contains p.url %}
                        <span class="sr-only">(current)</span>
                      {% endif %}
                    </a>
                  </li>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}

          <!-- Language toggle -->
          {% if page.lang_url %}
            <li class="toggle-container" style="display:flex;align-items:center;margin-left:1rem;">
              <a href="{{ page.lang_url | relative_url }}"
                 title="{% if page.lang == 'zh' %}Switch to English{% else %}切换到中文{% endif %}"
                 style="display:inline-flex;align-items:center;padding:3px 10px;border:1px solid currentColor;border-radius:4px;font-size:0.82rem;letter-spacing:0.02em;text-decoration:none;line-height:1.4;opacity:0.85;white-space:nowrap;">
                {% if page.lang == 'zh' %}
                  <span style="font-weight:600;">中文</span><span style="margin:0 2px;opacity:0.45;">/</span><span style="opacity:0.45;font-weight:400;">EN</span>
                {% else %}
                  <span style="opacity:0.45;font-weight:400;">中文</span><span style="margin:0 2px;opacity:0.45;">/</span><span style="font-weight:600;">EN</span>
                {% endif %}
              </a>
            </li>
          {% endif %}

        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
