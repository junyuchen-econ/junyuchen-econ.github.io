{% assign lang = page.lang | default: 'en' %}
<section class="learning-blog">
  {% if lang == 'zh' %}<h4 id="学习博客">学习博客</h4>{% else %}<h4 id="learning-blog">Learning Blog</h4>{% endif %}
  <div class="blog-cards">
    {% for post in site.data.learning_blog %}
      <article class="blog-card{% unless post.fig %} blog-card--text{% endunless %}">
        <div class="blog-card-text">
          <h5 class="blog-card-title"><a href="{{ post.url | relative_url }}">{{ post.title[lang] }}</a></h5>
          <p class="blog-card-desc">{{ post.text[lang] }}</p>
          <a class="blog-card-more" href="{{ post.url | relative_url }}">{% if lang == 'zh' %}阅读全文 →{% else %}Read the post →{% endif %}</a>
        </div>
        {% if post.fig %}<div class="blog-card-fig" data-blog-fig="{{ post.fig }}"></div>{% endif %}
      </article>
    {% endfor %}
  </div>
  <script defer src="{{ '/assets/js/blog-cards.js' | relative_url }}"></script>
</section>
